{
  "name": "lostark-cash-shop-value",
  "version": "1.12.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build:web && npm test && npm run typecheck && wrangler deploy",
    "build:web": "npm --prefix web install && npm --prefix web run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "postinstall": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "typescript": "^5.6.3",
    "vitest": "~5.0.3",
    "wrangler": "^4.145.0"
  }
}
