{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lostark-cash-shop-value",
  // The Cloudflare account that owns this Worker and its KV namespace. Pinned because the deploy
  // login can reach more than one account, and wrangler won't pick one non-interactively.
  "account_id": "54f3f98a86b6b393b108ac5891fbfca0",
  "main": "src/index.ts",
  // Kept at/under the bundled workerd's supported date (test + deploy runtimes).
  // Bump deliberately when upgrading wrangler. Sufficient for fetch/KV/Cache.
  "compatibility_date": "2025-09-06",
  "kv_namespaces": [
    { "binding": "PRICES", "id": "f0b70c68a0924c8eb173d8f622e4fd62" }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": { "enabled": true },
  "assets": {
    "directory": "./web/build",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1", "/v1/*", "/healthz"]
  }
}
